{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "resolveJsonModule": true,
    "paths": {
      "@forgeax/engine": [
        "../forgeax-engine/packages/engine/dist/index.d.ts"
      ],
      "@forgeax/engine/*": [
        "../forgeax-engine/packages/engine/dist/facades/*.d.ts"
      ]
    }
  },
  "include": [
    "assets/**/*.ts",
    "assets/**/*.d.ts",
    ".forgeax/generated/**/*.d.ts",
    "vitest.config.ts"
  ]
}
